# Copy this file to .env before starting:
#   copy .env.example .env

POSTGRES_USER=safety
POSTGRES_PASSWORD=safety
POSTGRES_DB=safety

DATABASE_URL=postgresql+psycopg://safety:safety@postgres:5432/safety
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=safetyadmin
MINIO_SECRET_KEY=safetyadmin123
MINIO_BUCKET=safety-evidence
MINIO_SECURE=false

# Browser-facing URLs. Inside Docker the services use the names above.
# 127.0.0.1, not localhost: on Windows localhost goes to IPv6 first, and Docker Desktop's IPv6 relay can hang after a container is recreated.
# On a server behind nginx set it to https://<your domain> (docs/DEPLOY.md). It is built into the frontend, so rebuild after changing it.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

JWT_SECRET=poc-local-demo-jwt-secret-change-me
INTERNAL_API_TOKEN=poc-internal-token
JWT_EXPIRE_MINUTES=720

# DEMO runs the full workflow without trained weights.
# REAL uses the built-in person detector and ONNX files in MODEL_PATH when present.
AI_MODE=DEMO
AI_DEVICE=cpu
# Inference threads per camera. Raise it for one camera on a big CPU, keep it low for many cameras.
AI_THREADS=2
MODEL_PATH=/models
DEFAULT_AI_FPS=5
# Seconds between PPE reads of the same person. ppe.onnx runs once per person crop.
PPE_INTERVAL_S=0.3
WORKER_ID=worker-01

DEMO_ADMIN_PASSWORD=admin123
DEMO_SAFETY_PASSWORD=safety123
DEMO_VIEWER_PASSWORD=viewer123

# On a server: https://<your domain>, the same as NEXT_PUBLIC_API_URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
